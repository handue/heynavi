{
  "expo": {
    "name": "HeyNavi",
    "slug": "heynavi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "heynavi",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.heynavi.hackathon2026",
      "supportsTablet": false,
      "appleTeamId": "2QXA6829D6"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.heynavi.hackathon2026"
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "HeyNavi uses the camera to look at your surroundings and describe what it sees, out loud.",
          "microphonePermission": "HeyNavi listens for your spoken commands, such as \"find a chair\" or \"stop\".",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "HeyNavi listens for your spoken commands, such as \"find a chair\" or \"stop\".",
          "speechRecognitionPermission": "HeyNavi turns your spoken commands into text on this iPhone so it can act on them."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
