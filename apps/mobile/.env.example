# HeyNavi mobile app configuration.
# Copy this file to apps/mobile/.env and fill in the values. Do not commit .env.
#
# Everything prefixed with EXPO_PUBLIC_ is inlined into the JavaScript bundle and is
# readable by anyone who has the app. Never put the Meta Model API key (or any other
# secret) in this file: it belongs only in the backend's environment.
# After editing, fully reload the app (shake menu > Reload) to pick up new values.

# Backend base URL, no trailing slash.
# On a physical iPhone this must be your Mac's LAN IP, not localhost, and both devices
# must be on the same Wi-Fi. Find the IP with: ipconfig getifaddr en0
# Start the backend so it listens on the LAN, from backend/:
#   uvicorn app.main:app --host 0.0.0.0 --port 8000
EXPO_PUBLIC_API_URL=http://192.168.1.23:8000

# App token sent as the X-HeyNavi-Token header.
# paste the same value as HEYNAVI_APP_TOKEN in backend/.env (not a secret; it ships in the app)
EXPO_PUBLIC_HEYNAVI_TOKEN=
