# Secrets: never commit real keys
.env
.env.*
!.env.example
*.pem
*.p8
*.p12
*.mobileprovision

# Python
backend/.venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/

# Backend runtime state: the day's model usage and app metric lines
backend/var/

# Benchmark inputs are personal photos; keep them local
backend/bench/frames/*
!backend/bench/frames/.gitkeep

# Benchmark results name your photos and hold per-run measurements; keep them local
backend/bench/results/*
!backend/bench/results/.gitkeep

# OS / editors
.DS_Store

# Demo video footage and renders (large, not source)
recordings/

# Photos, video and audio stay local (camera files can carry GPS); app images under assets are tracked
*.jpg
*.jpeg
*.heic
*.heif
*.mov
*.mp4
*.m4a
*.wav
*.aiff

# Logs (Metro logs hold transcripts and scene lines); save them under backend/var/ instead
*.log
logs/
# The published demo video, its captions and poster (no location data; checked)
!docs/assets/heynavi-demo.mp4
!docs/assets/heynavi-demo-poster.jpg
