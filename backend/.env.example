# HeyNavi backend settings. Copy to backend/.env (cp .env.example .env && chmod 600 .env).
# backend/.env is git-ignored. Never commit it, and never paste its values into chat.

# Meta Model API key from dev.meta.ai > API keys. Server-side only, never put it in the mobile app.
MODEL_API_KEY=

# Meta Model API base URL (OpenAI-compatible Chat Completions and Responses).
META_API_BASE_URL=https://api.meta.ai/v1

# Per-frame detector model, called through POST /v1/responses with store:false.
SAM_MODEL=sam-3.1

# Reasoning model for planning, verification, description and reading (off the main loop).
SPARK_MODEL=muse-spark-1.3

# Muse Spark reasoning effort; "minimal" is the lowest ("none" returns HTTP 400).
SPARK_REASONING_EFFORT=minimal

# Default timeout in seconds for each Meta API request.
META_TIMEOUT_SECONDS=20

# Total time budget in seconds for one sam-3.1 call from POST /v1/detect; past it the app gets HTTP 504 and sends the next frame (no retry).
SAM_TIMEOUT_SECONDS=4

# Total time budget in seconds for one Muse Spark call from POST /v1/scene; past it the app gets HTTP 504 and tries the next frame (no retry).
SCENE_TIMEOUT_SECONDS=12

# Output token cap for one scene reply from Muse Spark, reasoning tokens included; a reply cut off by it is refused.
SCENE_MAX_OUTPUT_TOKENS=2000

# Daily spending guard: once the day's SAM images and Spark tokens reach this list-price cost (USD, UTC day), model calls return HTTP 503 budget_exhausted.
DAILY_BUDGET_USD=25

# File that keeps the day's usage across restarts, relative to backend/ (git-ignored); "." keeps it in memory only.
USAGE_FILE=var/usage.json

# File that POST /v1/metrics appends the app's metric lines to, relative to backend/ (git-ignored); "." only logs them.
METRICS_FILE=var/metrics.jsonl

# Shared token the app sends in X-HeyNavi-Token; generate with python -c "import secrets; print(secrets.token_urlsafe(24))"
HEYNAVI_APP_TOKEN=

# Python log level: DEBUG, INFO, WARNING or ERROR. Request bodies and the key are never logged.
LOG_LEVEL=INFO
